      "Bash(git branch --show-current)",
      "Bash(git rev-parse *)",
      "Bash(git describe *)",
      "Bash(git ls-remote *)",
      "Bash(git fetch*)",
      "Bash(git pull --ff-only*)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push -u origin *)",
      "Bash(gh pr view*)",
